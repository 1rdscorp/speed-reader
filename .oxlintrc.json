{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react-*", "@/app/**", "@/features/**", "@/lib/**", "@/ui/**"],
                "message": "core/ is the framework-free reading engine: no React, no imports from the rest of the app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/**", "src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/features/**"],
                "message": "lib/ and ui/ are shared building blocks: they must not depend on features/ or app/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/features/**"],
                "message": "Features are independent slices: share code through lib/, ui/ or core/, and use relative imports inside a feature."
              }
            ]
          }
        ]
      }
    }
  ]
}
